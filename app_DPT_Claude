    doc.add_heading("6. Gaya Horizontal & Tahanan", level=2)
    doc.add_paragraph(
        f"Pa = {res['Pa']:.2f} | Pq = {res['Pq']:.2f} | Pw = {res['Pw']:.2f} | ΔPae = {res['dPae']:.2f} | "
        f"Pir = {res['Pir']:.2f} kN/m\n"
        f"Pasif depan (tereduksi) = {res['Pp_front']:.2f} | Pasif key (tereduksi) = {res['Pp_key']:.2f} kN/m\n"
        f"Kohesi efektif untuk geser/pasif = {res['c_d']:.2f} kPa | μ dipakai = {res['mu_eff']:.3f}"
    )

    doc.add_heading("7. Penulangan Beton (SNI 2847:2019)", level=2)
    cols = ["Elemen Struktur", "Kombinasi", "h (mm)", "Mu (kNm)", "As Perlu", "Tulangan", "D/C Lentur", "D/C Geser", "Status"]
    t_rb = doc.add_table(rows=1, cols=len(cols))
    t_rb.style = "Table Grid"
    for i, c in enumerate(cols):
        t_rb.rows[0].cells[i].text = c
    for _, r in df_rebar.iterrows():
        cells = t_rb.add_row().cells
        vals = [r["Elemen Struktur"], r["Kombinasi"], r["Tebal h (mm)"], r["Mu (kNm/m)"], r["As Perlu (mm²)"],
                r["Tulangan Terpasang"], r["D/C Lentur"], r["D/C Geser"], r["Status"]]
        for i, v in enumerate(vals):
            cells[i].text = str(v)

    doc.add_heading("8. Batasan Analisis", level=2)
    for line in LIMITATIONS:
        doc.add_paragraph(line, style="List Bullet")

    out = io.BytesIO()
    doc.save(out)
    out.seek(0)
    return out


def generate_excel_report(p, res, fig, df_sf, df_rebar):
    """Workbook berisi NILAI hasil perhitungan aplikasi (bukan rumus dinamis)."""
    wb = openpyxl.Workbook()
    f_title = Font(name="Calibri", size=14, bold=True, color="FFFFFF")
    f_bold = Font(name="Calibri", size=10, bold=True)
    fill_h = PatternFill("solid", fgColor="1E3A8A")
    fill_s = PatternFill("solid", fgColor="DBEAFE")
    thin = Side(style="thin", color="9CA3AF")
    border = Border(left=thin, right=thin, top=thin, bottom=thin)

    def write_table(ws, r0, headers, rows):
        for j, h in enumerate(headers, start=1):
            c = ws.cell(row=r0, column=j, value=h)
            c.font, c.fill, c.border = f_bold, fill_s, border
        for i, row in enumerate(rows, start=1):
            for j, v in enumerate(row, start=1):
                c = ws.cell(row=r0 + i, column=j, value=v)
                c.border = border
                if isinstance(v, float):
                    c.number_format = "0.000"
        return r0 + len(rows) + 2

    ws1 = wb.active
    ws1.title = "1_Input"
    ws1.merge_cells("A1:E1")
    ws1["A1"] = f"PERHITUNGAN DPT — {p.wall_type_name}"
    ws1["A1"].font, ws1["A1"].fill = f_title, fill_h
    ws1["A1"].alignment = Alignment(horizontal="center", vertical="center")
    ws1["A2"] = "Catatan: sheet ini berisi nilai hasil perhitungan aplikasi (bukan rumus dinamis)."
    ws1["A3"] = "Proyek:"
    ws1["B3"] = p.project_name
    ws1["A4"] = "Perencana:"
    ws1["B4"] = p.engineer_name
    inputs = [
        ("Tinggi Ekspos", "H_exp", p.H_exp, "m"), ("Df (dari muka pelat)", "Df", p.D_f, "m"),
        ("Tebal Puncak Stem", "t_top", p.t_top, "m"), ("Tebal Dasar Stem", "t_bot", p.t_bot, "m"),
        ("Panjang Toe", "B_toe", p.B_toe, "m"), ("Panjang Heel", "B_heel", p.B_heel, "m"),
        ("Tebal Slab Pangkal", "t_slab_base", p.t_slab_base, "m"), ("Tebal Slab Ujung", "t_slab_tip", p.t_slab_tip, "m"),
        ("Kedalaman Shear Key", "D_key", p.D_key, "m"), ("Lebar Shear Key", "B_key", p.B_key, "m"),
        ("Tinggi Pagar+Kawat", "H_fence", p.H_panel + p.H_wire if p.use_fence else 0.0, "m"),
        ("Tekanan Angin", "q_wind", p.q_wind, "kPa"), ("Surcharge", "q_surch", p.q_surch, "kPa"),
        ("γ Tanah Urug", "gamma_1", p.gamma_1, "kN/m3"), ("φ Tanah Urug", "phi_1", p.phi_1, "deg"),
        ("γ Tanah Dasar", "gamma_2", p.gamma_2, "kN/m3"), ("φ Tanah Dasar", "phi_2", p.phi_2, "deg"),
        ("c Tanah Dasar", "c_2", p.c_2, "kPa"), ("q_all (laporan tanah)", "q_all", p.q_all, "kPa"),
        ("δ/φ2", "delta_ratio", p.delta_ratio, "-"), ("μ input", "mu", p.mu_base, "-"),
        ("Reduksi kohesi", "R_c", p.R_c, "-"), ("Reduksi pasif", "R_pasif", p.R_pasif if p.use_passive else 0.0, "-"),
        ("Tanah depan diabaikan", "z_ign", p.z_ign, "m"), ("kh", "k_h", p.k_h, "-"),
        ("fc'", "fc", p.fc, "MPa"), ("fy", "fy", p.fy, "MPa"),
        ("Selimut dinding", "cc_wall", p.cc_wall, "mm"), ("Selimut slab", "cc_slab", p.cc_slab, "mm"),
        ("Tul. dinding", "D-s", f"D{p.D_wall}-{p.s_wall}", ""), ("Tul. heel", "D-s", f"D{p.D_heel}-{p.s_heel}", ""),
        ("Tul. toe", "D-s", f"D{p.D_toe}-{p.s_toe}", ""),
    ]
    write_table(ws1, 6, ["PARAMETER", "SIMBOL", "NILAI", "SATUAN"], inputs)
    buf = io.BytesIO()
    fig.savefig(buf, format="png", dpi=130, bbox_inches="tight")
    buf.seek(0)
    img = XLImage(buf)
    img.width, img.height = 480, 350
    ws1.add_image(img, "F6")

    ws2 = wb.create_sheet("2_Stabilitas")
    ws2["A1"] = "STABILITAS EKSTERNAL (nilai)"
    ws2["A1"].font = Font(name="Calibri", size=12, bold=True)
    r = write_table(ws2, 3, list(df_sf.columns), df_sf.values.tolist())
    forces = [
        ("Ka", res["Ka"]), ("Kp", res["Kp"]), ("Kae", res["Kae"]), ("kh", res["kh"]),
        ("Pa (kN/m)", res["Pa"]), ("Pq (kN/m)", res["Pq"]), ("Pw (kN/m)", res["Pw"]),
        ("ΔPae (kN/m)", res["dPae"]), ("Pir (kN/m)", res["Pir"]),
        ("Pasif depan tereduksi (kN/m)", res["Pp_front"]), ("Pasif key tereduksi (kN/m)", res["Pp_key"]),
        ("μ dipakai", res["mu_eff"]), ("c efektif geser/pasif (kPa)", res["c_d"]),
        ("ΣV dgn surcharge (kN/m)", res["V_all"]), ("ΣV tanpa surcharge (kN/m)", res["V_noq"]),
        ("ΣMR tanpa surcharge (kNm/m)", res["MR_noq"]),
        ("Fh statis (kN/m)", res["case_stat"]["Fh"]), ("Mo statis (kNm/m)", res["case_stat"]["Mo"]),
        ("Fh gempa (kN/m)", res["case_seis"]["Fh"]), ("Mo gempa (kNm/m)", res["case_seis"]["Mo"]),
    ]
    write_table(ws2, r, ["Besaran", "Nilai"], forces)

    ws3 = wb.create_sheet("3_Gaya_Vertikal")
    write_table(ws3, 1, list(res["df_v"].columns), res["df_v"].values.tolist())

    ws4 = wb.create_sheet("4_Penulangan")
    r = write_table(ws4, 1, list(df_rebar.columns), df_rebar.values.tolist())
    fr = res["found_rows"]
    write_table(ws4, r, list(fr.columns), fr.values.tolist())

    for ws in wb.worksheets:
        for col in ws.columns:
            letter = openpyxl.utils.get_column_letter(col[0].column)
            m = max((len(str(c.value)) for c in col if c.value is not None), default=10)
            ws.column_dimensions[letter].width = max(12, min(m + 3, 48))

    out = io.BytesIO()
    wb.save(out)
    out.seek(0)
    return out


