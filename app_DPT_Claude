            p.t_bot = st.number_input("Tebal Dasar Stem", min_value=0.15, max_value=2.0, value=0.35, step=0.01)
            p.B_heel = st.number_input("Panjang Heel", min_value=0.2, max_value=8.0, value=1.65, step=0.05)
            p.t_slab_tip = st.number_input("Tebal Slab Ujung", min_value=0.15, max_value=1.5, value=0.25, step=0.05)

        p.use_shear_key = st.checkbox("Gunakan Shear Key (Kunci Geser)", value=True)
        if p.use_shear_key:
            k1, k2 = st.columns(2)
            with k1:
                p.D_key = st.number_input("Kedalaman Key (m)", min_value=0.15, max_value=2.0, value=0.40, step=0.05)
            with k2:
                p.B_key = st.number_input("Lebar Key (m)", min_value=0.15, max_value=1.5, value=0.30, step=0.05)
