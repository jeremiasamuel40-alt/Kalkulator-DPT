            p.D_key, p.B_key = 0.0, 0.0

        st.header("3. Pagar Atas & Beban Lalu Lintas")
        p.use_fence = st.checkbox("Ada Pagar Precast di Puncak DPT", value=True)
        if p.use_fence:
            f1, f2 = st.columns(2)
            with f1:
                p.H_panel = st.number_input("Tinggi Panel Pagar (m)", min_value=0.5, max_value=4.0, value=2.00, step=0.1)
                p.q_wind = st.number_input("Tekanan Angin (kPa)", min_value=0.0, max_value=3.0, value=0.60, step=0.05)
            with f2:
                p.H_wire = st.number_input("Tinggi Kawat Duri (m)", min_value=0.0, max_value=1.5, value=0.50, step=0.1)
                p.d_pocket = st.number_input("Kedalaman Pocket (m)", min_value=0.2, max_value=1.0, value=0.50, step=0.05)
        else:
            p.H_panel, p.H_wire, p.q_wind, p.d_pocket = 0.0, 0.0, 0.0, 0.0
        p.q_surch = st.number_input("Beban Surcharge Jalan (kPa)", min_value=0.0, max_value=50.0, value=10.0, step=1.0)

        st.header("4. Parameter Tanah")
        s1, s2 = st.columns(2)
        with s1:
            p.gamma_1 = st.number_input("γ Tanah Urug (kN/m³)", 14.0, 22.0, 18.0, 0.5)
            p.phi_1 = st.number_input("φ Tanah Urug (°)", 15.0, 45.0, 30.0, 1.0)
            p.q_all = st.number_input("q_all laporan tanah (kPa, 0 = tidak dipakai)", 0.0, 600.0, 150.0, 10.0)
            p.mu_base = st.number_input("μ maksimum dasar (input)", 0.20, 0.75, 0.45, 0.05)
        with s2:
            p.gamma_2 = st.number_input("γ Tanah Dasar (kN/m³)", 14.0, 22.0, 18.5, 0.5)
            p.phi_2 = st.number_input("φ Tanah Dasar (°)", 15.0, 45.0, 32.0, 1.0)
            p.c_2 = st.number_input("c Tanah Dasar (kPa)", 0.0, 100.0, 5.0, 1.0)
            p.SF_bc_target = st.number_input("SF Daya Dukung Statis (min)", 2.0, 4.0, 3.0, 0.5)
        st.caption("c tanah urug diabaikan pada tekanan aktif (konservatif).")

        st.subheader("Tahanan Geser & Pasif")
        p.delta_ratio = st.slider("δ / φ₂ (gesekan dasar beton-tanah)", 0.50, 1.00, 0.67, 0.01)
        p.R_c = st.slider("Faktor reduksi kohesi c₂ (geser & pasif)", 0.0, 1.0, 0.5, 0.05)
        p.z_ign = st.number_input("Kedalaman tanah depan diabaikan (tergerus/terganggu, m)", 0.0, 3.0, 0.5, 0.1)
        p.use_passive = st.checkbox("Perhitungkan tekanan pasif (depan & shear key)", value=True)
        p.R_pasif = st.slider("Faktor reduksi pasif", 0.0, 1.0, 0.50, 0.05) if p.use_passive else 0.0

        st.header("5. Gempa")
        p.kh_mode = st.radio("Sumber kh", ["Input manual", "Dari PGA_M (kh = faktor × F_PGA × PGA)"])
        p.kh_manual, p.PGA, p.F_PGA, p.kh_factor = 0.15, 0.30, 1.0, 0.5
        if p.kh_mode.startswith("Input"):
            p.kh_manual = st.number_input("Koef. Gempa Horizontal (kh)", 0.00, 0.60, 0.15, 0.01)
        else:
            p.PGA = st.number_input("PGA batuan dasar (g)", 0.0, 1.5, 0.30, 0.01)
            p.F_PGA = st.number_input("F_PGA (faktor situs)", 0.5, 3.0, 1.0, 0.05)
            p.kh_factor = st.number_input("Faktor kh/PGA_M (verifikasi ke SNI)", 0.1, 1.0, 0.5, 0.05)
        p.k_h = calc_kh(p.kh_mode, p.kh_manual, p.PGA, p.F_PGA, p.kh_factor)
        st.caption(f"kh dipakai = {p.k_h:.3f}")
        p.delta_mo_ratio = st.slider("δ dinding Mononobe-Okabe / φ₁ (0 = konsisten Rankine)", 0.0, 0.67, 0.0, 0.01)

        with st.expander("Kriteria Safety Factor (verifikasi ke SNI 8460:2017)"):
            p.SF_ot_stat = st.number_input("Guling statis ≥", 1.0, 4.0, 2.0, 0.05)
            p.SF_sl_stat = st.number_input("Geser statis ≥", 1.0, 4.0, 1.5, 0.05)
            p.SF_ot_seis = st.number_input("Guling gempa ≥", 1.0, 4.0, 1.5, 0.05)
            p.SF_sl_seis = st.number_input("Geser gempa ≥", 1.0, 4.0, 1.15, 0.05)
            p.SF_bc_seis = st.number_input("Daya dukung gempa ≥", 1.0, 4.0, 2.0, 0.05)
            p.q_all_seis_factor = st.number_input("Faktor kenaikan q_all saat gempa", 1.0, 2.0, 1.5, 0.05)

        st.header("6. Material & Tulangan")
        m1, m2 = st.columns(2)
        with m1:
            p.fc = st.number_input("Mutu Beton fc' (MPa)", 17.5, 50.0, 25.0, 2.5)
            p.cc_wall = st.number_input("Selimut Dinding (mm)", 40, 75, 40, 5)
            p.D_wall = st.selectbox("Dia. Tul. Dinding (mm)", [10, 13, 16, 19, 22, 25], index=2)
            p.D_heel = st.selectbox("Dia. Tul. Heel (mm)", [10, 13, 16, 19, 22, 25], index=2)
            p.D_toe = st.selectbox("Dia. Tul. Toe (mm)", [10, 13, 16, 19, 22, 25], index=1)
        with m2:
            p.fy = st.number_input("Mutu Baja fy (MPa)", 240.0, 550.0, 420.0, 20.0)
            p.cc_slab = st.number_input("Selimut Slab Bawah (mm)", 50, 100, 75, 5)
            p.s_wall = st.number_input("Spasi Tul. Dinding (mm)", 75, 300, 150, 25)
            p.s_heel = st.number_input("Spasi Tul. Heel (mm)", 75, 300, 150, 25)
            p.s_toe = st.number_input("Spasi Tul. Toe (mm)", 75, 300, 150, 25)
    return p


def main():
    st.set_page_config(page_title="Kalkulator DPT - SNI 8460 & SNI 2847", page_icon="🧱", layout="wide")
    st.title("🧱 Kalkulator Analisis & Desain Dinding Penahan Tanah (DPT)")
    st.caption("Alat bantu preliminary. Acuan: SNI 8460:2017, SNI 2847:2019, SNI 1727:2020, SNI 1726:2019. "
               "Verifikasi seluruh kriteria terhadap dokumen resmi.")

    p = collect_inputs()

    if p.t_top > p.t_bot:
        st.error("Tebal puncak stem tidak boleh lebih besar dari tebal dasar stem.")
        st.stop()
    if p.t_slab_tip > p.t_slab_base:
        st.error("Tebal slab ujung tidak boleh lebih besar dari tebal slab pangkal.")
        st.stop()
    if p.cc_wall < 50 and p.D_wall >= 19:
        st.warning("Selimut dinding < 50 mm untuk tulangan ≥ D19 pada beton yang kontak tanah: periksa Tabel 20.5.1.3.1 SNI 2847:2019.")
    if p.cc_slab < 75:
        st.warning("Selimut slab < 75 mm: 75 mm berlaku untuk beton yang dicor langsung pada tanah. Pastikan ada lantai kerja bila memakai nilai lebih kecil.")

    res = run_calculations(p)
    fig = create_cross_section_plot(p, res)
    df_sf = build_sf_table(p, res)
    df_rebar = build_rebar_table(p, res)

    for w in res["warnings"]:
        st.warning(w)

    cs, ce = res["case_stat"], res["case_seis"]
    st.subheader("1. Ringkasan Safety Factor")
    c1, c2 = st.columns(2)

    def mark(ok_):
        return "✅" if ok_ else "❌"

    with c1:
        st.markdown("#### 🔹 Statis + Angin Pagar")
        a, b_, c_, d_ = st.columns(4)
        a.metric("Governing SF", f"{res['SF_gov_stat']:.2f}")
        b_.metric(f"Guling (≥ {p.SF_ot_stat:.2f})", f"{cs['SF_ot']:.2f} {mark(cs['SF_ot'] >= p.SF_ot_stat)}")
        c_.metric(f"Geser (≥ {p.SF_sl_stat:.2f})", f"{cs['SF_sl']:.2f} {mark(cs['SF_sl'] >= p.SF_sl_stat)}")
        d_.metric(f"Dukung (≥ {p.SF_bc_target:.1f})", f"{cs['SF_bc']:.2f} {mark(cs['SF_bc'] >= p.SF_bc_target)}")
    with c2:
        st.markdown("#### 🔸 Gempa (Mononobe-Okabe)")
        a, b_, c_, d_ = st.columns(4)
        a.metric("Governing SF", f"{res['SF_gov_seis']:.2f}")
        b_.metric(f"Guling (≥ {p.SF_ot_seis:.2f})", f"{ce['SF_ot']:.2f} {mark(ce['SF_ot'] >= p.SF_ot_seis)}")
        c_.metric(f"Geser (≥ {p.SF_sl_seis:.2f})", f"{ce['SF_sl']:.2f} {mark(ce['SF_sl'] >= p.SF_sl_seis)}")
        d_.metric(f"Dukung (≥ {p.SF_bc_seis:.1f})", f"{ce['SF_bc']:.2f} {mark(ce['SF_bc'] >= p.SF_bc_seis)}")

    show_df(df_sf)

    st.divider()
    left, right = st.columns([1.15, 1.0])
    with left:
        st.subheader("2. Visualisasi Penampang & Diagram Gaya")
        st.pyplot(fig)
    with right:
        st.subheader("3. Gaya Vertikal & Momen Penahan")
        st.dataframe(res["df_v"].style.format({"Gaya_V (kN/m)": "{:.2f}", "Lengan_x (m)": "{:.3f}",
                                               "Momen_Penahan (kNm/m)": "{:.2f}"}), hide_index=True)
        st.info(
            f"**Koefisien:** Ka = {res['Ka']:.3f} | Kp = {res['Kp']:.3f} | Kae = {res['Kae']:.3f} (kh = {res['kh']:.3f})\n\n"
            f"**Gaya dorong:** Pa = {res['Pa']:.2f} | Pq = {res['Pq']:.2f} | Pw = {res['Pw']:.2f} | "
            f"ΔPae = {res['dPae']:.2f} | Pir = {res['Pir']:.2f} kN/m\n\n"
            f"**Tahanan geser:** μ dipakai = {res['mu_eff']:.3f} (min dari μ input dan tan δ) | "
            f"c efektif = {res['c_d']:.2f} kPa | Pasif depan = {res['Pp_front']:.2f} | Pasif key = {res['Pp_key']:.2f} kN/m"
        )
        if cs["bc"] is not None:
            b_s = cs["bc"]
            st.caption(f"Kapasitas dukung statis: B' = {b_s['B_eff']:.2f} m, θ = {b_s['theta']:.1f}°, "
                       f"Nc/Nq/Nγ = {b_s['Nc']:.1f}/{b_s['Nq']:.1f}/{b_s['Ng']:.1f}, "
                       f"ic = {b_s['ic']:.2f}, iγ = {b_s['ig']:.2f}")

    st.divider()
    st.subheader("4. Desain Penulangan (SNI 2847:2019)")
    show_df(df_rebar)
    with st.expander("Reaksi tanah & momen pelat tiap kombinasi terfaktor"):
        fr = res["found_rows"]
        st.dataframe(fr.style.format({c: "{:.2f}" for c in fr.columns if c != "Kombinasi"}), hide_index=True)
    st.caption("Tulangan susut & suhu arah memanjang dipasang minimal sesuai Tabel 24.4.3.2 SNI 2847:2019 "
               "pada kedua sisi dinding dan pelat.")

    with st.expander("Batasan analisis (baca sebelum memakai hasil)"):
        for line in LIMITATIONS:
            st.markdown(f"- {line}")

    st.divider()
