def build_sf_table(p, res):
    cs, ce = res["case_stat"], res["case_seis"]
    B = res["B"]
    rows = []

    def ok(v, req):
        return "OK" if v >= req else "NOT OK"

    rows.append({
        "Kriteria Kontrol": "1. Stabilitas Guling",
        "Nilai Statis": f"{cs['SF_ot']:.2f}", "Syarat Statis": f"≥ {p.SF_ot_stat:.2f}",
        "Status Statis": ok(cs["SF_ot"], p.SF_ot_stat),
        "Nilai Gempa": f"{ce['SF_ot']:.2f}", "Syarat Gempa": f"≥ {p.SF_ot_seis:.2f}",
        "Status Gempa": ok(ce["SF_ot"], p.SF_ot_seis),
    })
    rows.append({
        "Kriteria Kontrol": "2. Stabilitas Geser",
        "Nilai Statis": f"{cs['SF_sl']:.2f}", "Syarat Statis": f"≥ {p.SF_sl_stat:.2f}",
        "Status Statis": ok(cs["SF_sl"], p.SF_sl_stat),
        "Nilai Gempa": f"{ce['SF_sl']:.2f}", "Syarat Gempa": f"≥ {p.SF_sl_seis:.2f}",
        "Status Gempa": ok(ce["SF_sl"], p.SF_sl_seis),
    })

    def bc_txt(c):
        if c["bc"] is None:
            return "n/a"
        return f"{c['SF_bc']:.2f} (q_ult={c['bc']['q_ult']:.0f}, q_eff={c['q_app']:.0f} kPa)"

    rows.append({
        "Kriteria Kontrol": "3. Kapasitas Dukung (Meyerhof, B', beban miring)",
        "Nilai Statis": bc_txt(cs), "Syarat Statis": f"≥ {p.SF_bc_target:.2f}",
        "Status Statis": ok(cs["SF_bc"], p.SF_bc_target),
        "Nilai Gempa": bc_txt(ce), "Syarat Gempa": f"≥ {p.SF_bc_seis:.2f}",
        "Status Gempa": ok(ce["SF_bc"], p.SF_bc_seis),
    })
    if p.q_all > 0:
        lim_seis = p.q_all * p.q_all_seis_factor
        rows.append({
            "Kriteria Kontrol": "4. q_maks ≤ q_all (laporan tanah)",
            "Nilai Statis": f"{cs['press']['q_max']:.1f} kPa", "Syarat Statis": f"≤ {p.q_all:.0f} kPa",
            "Status Statis": "OK" if cs["press"]["q_max"] <= p.q_all else "NOT OK",
            "Nilai Gempa": f"{ce['press']['q_max']:.1f} kPa", "Syarat Gempa": f"≤ {lim_seis:.0f} kPa",
            "Status Gempa": "OK" if ce["press"]["q_max"] <= lim_seis else "NOT OK",
        })
    rows.append({
        "Kriteria Kontrol": "5. Eksentrisitas Dasar",
        "Nilai Statis": f"e = {cs['press']['e']:.3f} m", "Syarat Statis": f"|e| ≤ {B/6.0:.3f} m",
        "Status Statis": "OK" if cs["press"]["valid"] and abs(cs["press"]["e"]) <= B / 6.0 else "NOT OK",
        "Nilai Gempa": f"e = {ce['press']['e']:.3f} m", "Syarat Gempa": f"|e| ≤ {B/4.0:.3f} m",
        "Status Gempa": "OK" if ce["press"]["valid"] and abs(ce["press"]["e"]) <= B / 4.0 else "NOT OK",
    })
    return pd.DataFrame(rows)


def build_rebar_table(p, res):
    rows = []

    def add(elem, side, rb, dia, sp):
        if rb is None:
            rows.append({"Elemen Struktur": elem, "Sisi Tarik": side, "Tebal h (mm)": "-",
                         "Kombinasi": "-", "Mu (kNm/m)": "-", "As Perlu (mm²)": "-",
                         "Tulangan Terpasang": "Tidak ada (B_toe = 0)", "As Pasang (mm²)": "-",
                         "D/C Lentur": "-", "Vu (kN/m)": "-", "φVc (kN/m)": "-", "D/C Geser": "-",
                         "Status": "N/A", "Catatan": ""})
            return
        as_req = "-" if rb["As_req"] != rb["As_req"] else f"{rb['As_req']:.0f}"
        rows.append({
            "Elemen Struktur": elem, "Sisi Tarik": side, "Tebal h (mm)": f"{rb['h_mm']:.0f}",
            "Kombinasi": rb.get("combo", "-"), "Mu (kNm/m)": f"{rb['Mu']:.2f}",
            "As Perlu (mm²)": as_req, "Tulangan Terpasang": f"D{dia}-{sp}",
            "As Pasang (mm²)": f"{rb['As_prov']:.0f}", "D/C Lentur": f"{rb['dc_flex']:.2f}",
            "Vu (kN/m)": f"{rb['Vu']:.2f}", "φVc (kN/m)": f"{rb['phi_Vc']:.2f}",
            "D/C Geser": f"{rb['dc_shear']:.2f}", "Status": rb["status"], "Catatan": rb["notes"],
        })

    add("Dinding Vertikal (Stem)", "Sisi Dalam (Backfill)", res["rebar_stem"], p.D_wall, p.s_wall)
    add("Slab Belakang (Heel)", "Serat Atas", res["rebar_heel"], p.D_heel, p.s_heel)
    add("Slab Depan (Toe)", "Serat Bawah", res["rebar_toe"], p.D_toe, p.s_toe)
    if res["rebar_pocket"] is not None:
        add("Dinding Pocket Pagar (pendekatan)", "Lokal", res["rebar_pocket"], 10, 150)
    return pd.DataFrame(rows)


