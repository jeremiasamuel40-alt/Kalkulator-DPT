def _integrate(fn, a, b, n=400):
    """Integral trapesium fn(x) dari a ke b."""
    if b - a <= 1e-9:
        return 0.0
    xs = np.linspace(a, b, n + 1)
    ys = np.asarray(fn(xs), dtype=float)
    return float(np.sum((ys[:-1] + ys[1:]) * 0.5 * np.diff(xs)))


def base_pressure(V, M_net, B):
    """
    Distribusi tegangan dasar linear dari resultan vertikal V dan momen netto
    terhadap ujung depan (toe). x = 0 di ujung toe. Menangani e > B/6 (kontak
    parsial) dan e < 0 (resultan bergeser ke heel).
    """
    out = {
        "valid": False, "xR": 0.0, "e": 0.0, "q_toe": 0.0, "q_heel": 0.0,
        "q_max": 0.0, "q_min": 0.0, "Lc": 0.0, "mode": "tidak valid",
        "fn": (lambda x: np.zeros_like(np.asarray(x, dtype=float))),
    }
    if V <= 1e-9:
        return out
    xR = M_net / V
    e = B / 2.0 - xR  # e > 0: resultan bergeser ke arah toe
    out["xR"], out["e"] = xR, e
    if xR <= 0.0 or xR >= B:
        out["mode"] = "resultan di luar dasar (guling)"
        return out

    if abs(e) <= B / 6.0 + 1e-12:
        q_toe = V / B * (1.0 + 6.0 * e / B)
        q_heel = V / B * (1.0 - 6.0 * e / B)
        Lc = B
        mode = "kontak penuh"

        def fn(x, a=q_toe, b=q_heel):
            return a + (b - a) * np.asarray(x, dtype=float) / B
    elif e > 0:
        Lc = 3.0 * xR
        q_toe, q_heel = 2.0 * V / Lc, 0.0
        mode = "kontak parsial (dari toe)"

        def fn(x, Lc=Lc, qt=q_toe):
            xx = np.asarray(x, dtype=float)
            return np.where(xx <= Lc, qt * (1.0 - xx / Lc), 0.0)
    else:
        Lc = 3.0 * (B - xR)
        q_toe, q_heel = 0.0, 2.0 * V / Lc
        mode = "kontak parsial (dari heel)"

        def fn(x, Lc=Lc, qh=q_heel):
            xr = B - np.asarray(x, dtype=float)
            return np.where(xr <= Lc, qh * (1.0 - xr / Lc), 0.0)

    out.update({
        "valid": True, "q_toe": q_toe, "q_heel": q_heel,
        "q_max": max(q_toe, q_heel), "q_min": min(q_toe, q_heel),
        "Lc": Lc, "mode": mode, "fn": fn,
    })
    return out


def meyerhof_qult(c, phi_deg, gamma, D, B_eff, theta_deg):
    """
    Kapasitas dukung ultimit pondasi menerus (Meyerhof) dengan faktor kedalaman
    dan faktor kemiringan beban. Satuan kPa. D = kedalaman efektif (m).
    """
    phi = math.radians(phi_deg)
    if phi_deg < 1e-6:
        Nq, Nc, Ng = 1.0, 5.14, 0.0
    else:
        Nq = math.exp(math.pi * math.tan(phi)) * math.tan(math.radians(45.0 + phi_deg / 2.0)) ** 2
        Nc = (Nq - 1.0) / math.tan(phi)
        Ng = (Nq - 1.0) * math.tan(1.4 * phi)
    Kp_m = math.tan(math.radians(45.0 + phi_deg / 2.0)) ** 2
    ratio = D / B_eff if B_eff > 0 else 0.0
    dc = 1.0 + 0.2 * math.sqrt(Kp_m) * ratio
    dq = dg = (1.0 + 0.1 * math.sqrt(Kp_m) * ratio) if phi_deg > 10.0 else 1.0
    ic = iq = max(0.0, 1.0 - theta_deg / 90.0) ** 2
    ig = max(0.0, 1.0 - theta_deg / phi_deg) ** 2 if phi_deg > 0 else 0.0
    q_over = gamma * D
    t_c = c * Nc * dc * ic
    t_q = q_over * Nq * dq * iq
    t_g = 0.5 * gamma * B_eff * Ng * dg * ig
    return {
        "q_ult": t_c + t_q + t_g, "Nc": Nc, "Nq": Nq, "Ng": Ng,
        "dc": dc, "dq": dq, "ic": ic, "ig": ig, "theta": theta_deg,
        "B_eff": B_eff, "q_over": q_over,
    }


def calc_kh(mode, kh_manual, pga, f_pga, factor):
    """kh manual atau kh = faktor x F_PGA x PGA (dalam g). Faktor wajib diverifikasi."""
    if mode.startswith("Input"):
        return kh_manual
    return factor * f_pga * pga


# ==============================================================================
# CEK PENAMPANG BETON (SNI 2847:2019, per 1 m lebar)
# ==============================================================================
def check_section(Mu, Vu, h_mm, cc_mm, db_mm, sp_mm, fc, fy, fail_note=None):
    b = 1000.0
    d = h_mm - cc_mm - 0.5 * db_mm
    notes = []
    As_prov = (1000.0 / sp_mm) * (0.25 * math.pi * db_mm ** 2)
    rho_min = 0.0020 if fy < 420.0 else max(0.0018 * 420.0 / fy, 0.0014)
    As_min = rho_min * b * h_mm
    base = {
        "h_mm": h_mm, "d_mm": d, "Mu": Mu, "Vu": Vu, "As_prov": As_prov,
        "As_min": As_min,
    }
    if d < 30.0:
        base.update({
            "As_req": float("nan"), "phi_Mn": 0.0, "dc_flex": 99.0, "phi_Vc": 0.0,
            "dc_shear": 99.0, "eps_t": float("nan"), "s_max": float("nan"),
            "status": "NOT OK", "notes": "Tinggi efektif d tidak valid (penampang terlalu tipis)",
        })
        return base

    beta1 = 0.85 if fc <= 28.0 else max(0.65, 0.85 - 0.05 * (fc - 28.0) / 7.0)

    # As perlu (asumsi tension-controlled, phi = 0,9)
    Rn = (Mu * 1e6) / (0.9 * b * d ** 2)
    term = 1.0 - (2.0 * Rn) / (0.85 * fc)
    if term <= 0:
        As_flex = 0.05 * b * d
        notes.append("Penampang terlalu tipis untuk Mu")
        too_thin = True
    else:
        As_flex = (0.85 * fc / fy) * (1.0 - math.sqrt(term)) * b * d
        too_thin = False
    As_req = max(As_flex, As_min)

    # Kapasitas lentur dengan phi dari regangan tarik
    a = (As_prov * fy) / (0.85 * fc * b)
    c_na = a / beta1
    eps_t = 0.003 * (d - c_na) / c_na if c_na > 0 else 0.01
    if eps_t >= 0.005:
        phi_f = 0.90
    elif eps_t <= 0.002:
        phi_f = 0.65
    else:
        phi_f = 0.65 + 0.25 * (eps_t - 0.002) / 0.003
    phi_Mn = phi_f * As_prov * fy * (d - a / 2.0) / 1e6
    dc_flex = Mu / phi_Mn if phi_Mn > 0 else 99.0

    # Geser satu arah tanpa sengkang (Tabel 22.5.5.1 butir Av < Av,min), lambda = 1
    rho_w = As_prov / (b * d)
    lam_s = min(1.0, math.sqrt(2.0 / (1.0 + d / 250.0)))
    sqrt_fc = min(math.sqrt(fc), 8.3)
    Vc = min(0.66 * lam_s * (rho_w ** (1.0 / 3.0)) * sqrt_fc * b * d,
             0.42 * sqrt_fc * b * d) / 1000.0
    phi_Vc = 0.75 * Vc
    dc_shear = Vu / phi_Vc if phi_Vc > 0 else 99.0

    # Spasi maksimum pengendalian retak (Pasal 24.3.2), fs = 2/3 fy
    fs = 2.0 / 3.0 * fy
    s_max = min(380.0 * (280.0 / fs) - 2.5 * cc_mm, 300.0 * (280.0 / fs))

    ok = True
    if dc_flex > 1.0:
        ok = False
        notes.append("Lentur kurang")
    if dc_shear > 1.0:
        ok = False
        notes.append("Geser kurang (perlu tebal/tulangan lebih besar atau sengkang)")
    if As_prov < As_min:
        ok = False
        notes.append("As < As min")
    if eps_t < 0.004:
        ok = False
        notes.append("Tidak memenuhi batas regangan tarik")
    if sp_mm > s_max:
        ok = False
        notes.append(f"Spasi > {s_max:.0f} mm")
    if too_thin:
        ok = False
    if fail_note:
        ok = False
        notes.append(fail_note)

    base.update({
        "As_req": As_req, "phi_Mn": phi_Mn, "dc_flex": dc_flex, "phi_Vc": phi_Vc,
        "dc_shear": dc_shear, "eps_t": eps_t, "s_max": s_max,
        "status": "OK" if ok else "NOT OK", "notes": "; ".join(notes),
    })
    return base


# ==============================================================================
# MESIN PERHITUNGAN
# ==============================================================================
def run_calculations(p):
    gc = GAMMA_C
    B = p.B_toe + p.t_bot + p.B_heel
    H_stem = p.H_exp + p.D_f            # tinggi stem di atas muka pelat
    H_tot = H_stem + p.t_slab_base      # tinggi total dari dasar pelat
    D_emb = p.t_slab_base + p.D_f       # kedalaman muka tanah depan terhadap dasar pelat
    dt_slab = max(0.0, p.t_slab_base - p.t_slab_tip)
    dtt = max(0.0, p.t_bot - p.t_top)
    phi1 = math.radians(p.phi_1)
    phi2 = math.radians(p.phi_2)
    kh = p.k_h
    warnings = []

    # ---------------- 1. Koefisien tekanan tanah ----------------
    Ka = math.tan(math.radians(45.0 - p.phi_1 / 2.0)) ** 2
    Kp = math.tan(math.radians(45.0 + p.phi_2 / 2.0)) ** 2

    # Mononobe-Okabe (beta = i = 0, kv = 0). delta dinding default 0 -> konsisten dengan Rankine
    delta_mo = p.delta_mo_ratio * phi1
    psi = math.atan(kh)
    seismic_valid = (kh <= 0) or (phi1 > psi)
    if kh > 0 and seismic_valid:
        num = math.cos(phi1 - psi) ** 2
        sq = math.sqrt((math.sin(phi1 + delta_mo) * math.sin(phi1 - psi)) / math.cos(delta_mo + psi))
        den = math.cos(psi) * math.cos(delta_mo + psi) * ((1.0 + sq) ** 2)
        Kae = num / den
        dKae = max(0.0, Kae - Ka)
    else:
        Kae, dKae = Ka, 0.0
    if not seismic_valid:
        warnings.append("phi tanah urug <= arctan(kh): Mononobe-Okabe tidak valid, kondisi gempa dianggap GAGAL.")

    # ---------------- 2. Gaya vertikal & momen penahan (x = 0 di ujung toe) ----------------
    items = []  # (nama, V, x, jenis, y_inersia)

    def add(name, V, x, kind, y=None):
        items.append((name, V, x, kind, y))

    w1 = p.t_top * H_stem * gc
    x1 = p.B_toe + dtt + p.t_top / 2.0
    add("W1 - Dinding (Stem Persegi)", w1, x1, "beton", p.t_slab_base + H_stem / 2.0)

    w2 = 0.5 * dtt * H_stem * gc
    x2 = p.B_toe + (2.0 / 3.0) * dtt
    add("W2 - Dinding (Stem Miring)", w2, x2, "beton", p.t_slab_base + H_stem / 3.0)

    w3a = (p.B_toe + p.t_bot) * p.t_slab_base * gc
    x3a = (p.B_toe + p.t_bot) / 2.0
    add("W3a - Pelat Dasar (Toe + bawah Stem)", w3a, x3a, "beton", p.t_slab_base / 2.0)

    w3b = p.B_heel * p.t_slab_tip * gc
    x3b = p.B_toe + p.t_bot + p.B_heel / 2.0
    add("W3b - Pelat Dasar (Heel, tebal ujung)", w3b, x3b, "beton", p.t_slab_tip / 2.0)

    w4 = 0.5 * p.B_heel * dt_slab * gc
    x4 = p.B_toe + p.t_bot + p.B_heel / 3.0
    add("W4 - Pelat Dasar (Miring Heel)", w4, x4, "beton", p.t_slab_tip + dt_slab / 3.0)

    w5 = p.B_key * p.D_key * gc if p.use_shear_key else 0.0
    x5 = p.B_toe + p.t_bot - p.B_key / 2.0
    add("W5 - Shear Key Beton", w5, x5, "beton", 0.0)  # y = 0: lengan inersia key diabaikan

    w6a = p.B_heel * H_stem * p.gamma_1
    x6a = p.B_toe + p.t_bot + p.B_heel / 2.0
    w6b = 0.5 * p.B_heel * dt_slab * p.gamma_1
    x6b = p.B_toe + p.t_bot + (2.0 / 3.0) * p.B_heel
    w6 = w6a + w6b
    x6 = (w6a * x6a + w6b * x6b) / w6 if w6 > 0 else x6a
    add("W6 - Tanah Urug di atas Heel", w6, x6, "tanah")

    w7 = p.q_surch * p.B_heel
    x7 = p.B_toe + p.t_bot + p.B_heel / 2.0
    add("W7 - Beban Surcharge di atas Heel", w7, x7, "hidup")

    w8 = p.B_toe * p.D_f * p.gamma_2
    x8 = p.B_toe / 2.0
    add("W8 - Tanah Penutup di atas Toe", w8, x8, "tanah")

    w9 = (p.H_panel * 0.05 * gc + 0.35) if p.use_fence else 0.0  # estimasi panel 50 mm + kolom
    x9 = x1
    add("W9 - Berat Pagar Precast Atas", w9, x9, "beton", H_tot + p.H_panel / 2.0)

    df_v = pd.DataFrame([(n, V, x) for n, V, x, _, _ in items],
                        columns=["Komponen", "Gaya_V (kN/m)", "Lengan_x (m)"])
    df_v["Momen_Penahan (kNm/m)"] = df_v["Gaya_V (kN/m)"] * df_v["Lengan_x (m)"]

    V_all = sum(V for _, V, _, _, _ in items)
    MR_all = sum(V * x for _, V, x, _, _ in items)
    V_noq = V_all - w7
    MR_noq = MR_all - w7 * x7
    V_dead = V_noq
    MR_dead = MR_noq

    # ---------------- 3. Gaya horizontal ----------------
    Pa = 0.5 * Ka * p.gamma_1 * H_tot ** 2
    ya = H_tot / 3.0
    Pq = Ka * p.q_surch * H_tot
    yq = H_tot / 2.0
    H_fence_tot = (p.H_panel + p.H_wire) if p.use_fence else 0.0
    Pw = p.q_wind * H_fence_tot
    yw = H_tot + H_fence_tot / 2.0
    dPae = 0.5 * dKae * p.gamma_1 * H_tot ** 2
    ydae = 0.6 * H_tot

    W_inert = sum(V for _, V, _, kind, _ in items if kind == "beton")
    M_inert = sum(V * y for _, V, _, kind, y in items if kind == "beton")
    Pir = kh * W_inert
    yir = (M_inert / W_inert) if W_inert > 0 else 0.45 * H_tot

    # ---------------- 4. Tahanan geser ----------------
    delta_b = p.delta_ratio * phi2
    mu_eff = min(p.mu_base, math.tan(delta_b))
    c_d = p.R_c * p.c_2
    z0 = min(p.z_ign, D_emb)
    Pp_front_raw = 0.5 * Kp * p.gamma_2 * (D_emb ** 2 - z0 ** 2) + 2.0 * c_d * math.sqrt(Kp) * (D_emb - z0)
    Pp_key_raw = (0.5 * Kp * p.gamma_2 * p.D_key ** 2 + 2.0 * c_d * math.sqrt(Kp) * p.D_key) if p.use_shear_key else 0.0
    Rp = p.R_pasif if p.use_passive else 0.0
    Pp_front = Rp * Pp_front_raw
    Pp_key = Rp * Pp_key_raw
    D_bc = max(0.0, D_emb - z0)  # kedalaman efektif untuk daya dukung

    def evaluate_case(Fh, Mo):
        press = base_pressure(V_all, MR_all - Mo, B)
        SF_ot = MR_noq / Mo if Mo > 0 else 99.0
        Lc = press["Lc"] if press["valid"] else 0.0
        Fr = mu_eff * V_noq + c_d * Lc + Pp_front + Pp_key
        SF_sl = Fr / Fh if Fh > 0 else 99.0
        if press["valid"]:
            theta = math.degrees(math.atan2(Fh, V_all))
            B_eff = B - 2.0 * abs(press["e"])
            bc = meyerhof_qult(p.c_2, p.phi_2, p.gamma_2, D_bc, B_eff, theta)
            q_app = V_all / B_eff if B_eff > 0 else float("inf")
            SF_bc = bc["q_ult"] / q_app if q_app > 0 else 99.0
        else:
            bc = None
            q_app = float("inf")
            SF_bc = 0.0
        return {
            "Fh": Fh, "Mo": Mo, "Fr": Fr, "press": press, "SF_ot": SF_ot, "SF_sl": SF_sl,
            "SF_bc": SF_bc, "bc": bc, "q_app": q_app,
        }

    Fh_stat = Pa + Pq + Pw
    Mo_stat = Pa * ya + Pq * yq + Pw * yw
    case_stat = evaluate_case(Fh_stat, Mo_stat)

    Fh_seis = Pa + Pq + dPae + Pir
    Mo_seis = Pa * ya + Pq * yq + dPae * ydae + Pir * yir
    case_seis = evaluate_case(Fh_seis, Mo_seis)
    if not seismic_valid:
        case_seis["SF_ot"] = case_seis["SF_sl"] = case_seis["SF_bc"] = 0.0

    for tag, cs in (("statis", case_stat), ("gempa", case_seis)):
        if not cs["press"]["valid"]:
            warnings.append(f"Kondisi {tag}: resultan di luar dasar pondasi (guling).")
        elif cs["press"]["mode"].startswith("kontak parsial"):
            warnings.append(f"Kondisi {tag}: eksentrisitas melebihi B/6 ({cs['press']['mode']}).")

    q_stat, q_seis = case_stat["press"], case_seis["press"]
    SF_gov_stat = min(case_stat["SF_ot"], case_stat["SF_sl"], case_stat["SF_bc"])
    SF_gov_seis = min(case_seis["SF_ot"], case_seis["SF_sl"], case_seis["SF_bc"])

    # ---------------- 5. Struktur beton ----------------
    # 5A. Stem: penampang kritis di muka atas pelat
    Hs = H_stem
    Pa_s = 0.5 * Ka * p.gamma_1 * Hs ** 2
    Pq_s = Ka * p.q_surch * Hs
    dPae_s = 0.5 * dKae * p.gamma_1 * Hs ** 2
    inert_s = [(w1, Hs / 2.0), (w2, Hs / 3.0), (w9, Hs + p.H_panel / 2.0)]
    Pir_s = kh * sum(w for w, _ in inert_s)
    M_Pir_s = kh * sum(w * y for w, y in inert_s)

    Mu_s1 = 1.6 * (Pa_s * Hs / 3.0 + Pq_s * Hs / 2.0) + 1.0 * Pw * (Hs + H_fence_tot / 2.0)
    Mu_s2 = (1.6 * Pa_s * Hs / 3.0 + 1.0 * Pq_s * Hs / 2.0 + 1.0 * (dPae_s * 0.6 * Hs + M_Pir_s))
    d_stem = (p.t_bot * 1000.0 - p.cc_wall - 0.5 * p.D_wall) / 1000.0
    Hv = max(0.1, Hs - d_stem)
    Pa_v = 0.5 * Ka * p.gamma_1 * Hv ** 2
    Pq_v = Ka * p.q_surch * Hv
    dPae_v = 0.5 * dKae * p.gamma_1 * Hv ** 2
    Vu_s1 = 1.6 * (Pa_v + Pq_v) + 1.0 * Pw
    Vu_s2 = 1.6 * Pa_v + 1.0 * Pq_v + 1.0 * (dPae_v + Pir_s)
    stem_cases = [("1.6H + 1.6L + 1.0W", Mu_s1, Vu_s1)]
    if seismic_valid:
        stem_cases.append(("1.6H + 1.0L + 1.0E", Mu_s2, Vu_s2))
    gov_stem = max(stem_cases, key=lambda t: t[1])
    Mu_stem = gov_stem[1]
    Vu_stem = max(t[2] for t in stem_cases)
    rebar_stem = check_section(Mu_stem, Vu_stem, p.t_bot * 1000.0, p.cc_wall, p.D_wall, p.s_wall, p.fc, p.fy)
    rebar_stem["combo"] = gov_stem[0]

    # 5B. Pocket pagar (pendekatan; detail pocket sebaiknya didesain khusus)
    if p.use_fence and Pw > 0:
        Mu_pocket = 1.0 * Pw * (H_fence_tot / 2.0 + p.d_pocket / 2.0)
        t_pocket_wall = (p.t_top * 1000.0 - 170.0) / 2.0  # asumsi lebar pocket 170 mm
        rebar_pocket = check_section(Mu_pocket, 1.0 * Pw, t_pocket_wall, 25.0, 10, 150, p.fc, p.fy,
                                     fail_note="Detail pocket perlu desain khusus")
        rebar_pocket["combo"] = "1.0W"
    else:
        rebar_pocket = None

    # 5C. Pelat dasar: reaksi tanah dihitung ulang untuk tiap kombinasi terfaktor
    combos = [
        ("1.2D + 1.6L + 1.6H + 1.0W", 1.2, 1.6, 1.6, 1.6, 1.0, 0.0),
        ("0.9D + 1.6H + 1.0W", 0.9, 0.0, 1.6, 1.6, 1.0, 0.0),
    ]
    if seismic_valid:
        combos += [
            ("1.2D + 1.0L + 1.6H + 1.0E", 1.2, 1.0, 1.6, 1.0, 0.0, 1.0),
            ("0.9D + 1.6H + 1.0E", 0.9, 0.0, 1.6, 1.0, 0.0, 1.0),
        ]

    x_face = p.B_toe + p.t_bot
    d_slab_m = (p.t_slab_base * 1000.0 - p.cc_slab - 0.5 * p.D_heel) / 1000.0
    d_toe_m = (p.t_slab_base * 1000.0 - p.cc_slab - 0.5 * p.D_toe) / 1000.0
    W_slab_toe = p.B_toe * p.t_slab_base * gc
    rows_found = []
    heel_best = {"Mu": 0.0, "Vu": 0.0, "combo": "-"}
    toe_best = {"Mu": 0.0, "Vu": 0.0, "combo": "-"}
    foundation_invalid = False
    for name, fD, fLv, fH, fLh, fW, fE in combos:
        V_c = fD * V_dead + fLv * w7
        MR_c = fD * MR_dead + fLv * w7 * x7
        Mo_c = (fH * Pa * ya + fLh * Pq * yq + fW * Pw * yw + fE * (dPae * ydae + Pir * yir))
        pr = base_pressure(V_c, MR_c - Mo_c, B)
        if not pr["valid"]:
            foundation_invalid = True
            rows_found.append({"Kombinasi": name, "ΣV_u (kN/m)": V_c, "e (m)": float("nan"),
                               "q_toe (kPa)": float("nan"), "q_heel (kPa)": float("nan"),
                               "Mu heel (kNm/m)": float("nan"), "Mu toe (kNm/m)": float("nan")})
            continue
        q = pr["fn"]
        # Heel: beban ke bawah dikurangi reaksi tanah, momen terhadap muka dalam stem
        down = [(fD * w6, x6), (fD * w3b, x3b), (fD * w4, x4), (fLv * w7, x7)]
        V_down = sum(F for F, _ in down)
        M_down = sum(F * (x - x_face) for F, x in down)
        F_up = _integrate(q, x_face, B)
        M_up = _integrate(lambda xs: q(xs) * (xs - x_face), x_face, B)
        Mu_h = max(0.0, M_down - M_up)
        Vu_h = max(0.0, V_down - F_up)
        if Mu_h > heel_best["Mu"] or heel_best["combo"] == "-":
            heel_best["Mu"], heel_best["combo"] = Mu_h, name
        heel_best["Vu"] = max(heel_best["Vu"], Vu_h)

        # Toe: reaksi tanah ke atas dikurangi berat pelat toe + tanah penutup
        Mu_t = Vu_t = 0.0
        if p.B_toe > 0.05:
            dead_toe = fD * (W_slab_toe + w8)
            M_up_t = _integrate(lambda xs: q(xs) * (p.B_toe - xs), 0.0, p.B_toe)
            Mu_t = max(0.0, M_up_t - dead_toe * (p.B_toe / 2.0))
            L_v = max(0.0, p.B_toe - d_toe_m)
            F_up_t = _integrate(q, 0.0, L_v)
            Vu_t = max(0.0, F_up_t - dead_toe * (L_v / p.B_toe))
            if Mu_t > toe_best["Mu"] or toe_best["combo"] == "-":
                toe_best["Mu"], toe_best["combo"] = Mu_t, name
            toe_best["Vu"] = max(toe_best["Vu"], Vu_t)
        rows_found.append({"Kombinasi": name, "ΣV_u (kN/m)": V_c, "e (m)": pr["e"],
                           "q_toe (kPa)": pr["q_toe"], "q_heel (kPa)": pr["q_heel"],
                           "Mu heel (kNm/m)": Mu_h, "Mu toe (kNm/m)": Mu_t})

    note_f = "Resultan di luar dasar pada kombinasi terfaktor" if foundation_invalid else None
    rebar_heel = check_section(heel_best["Mu"], heel_best["Vu"], p.t_slab_base * 1000.0, p.cc_slab,
                               p.D_heel, p.s_heel, p.fc, p.fy, fail_note=note_f)
    rebar_heel["combo"] = heel_best["combo"]
    if p.B_toe > 0.05:
        rebar_toe = check_section(toe_best["Mu"], toe_best["Vu"], p.t_slab_base * 1000.0, p.cc_slab,
                                  p.D_toe, p.s_toe, p.fc, p.fy, fail_note=note_f)
        rebar_toe["combo"] = toe_best["combo"]
    else:
        rebar_toe = None

    return {
        "B": B, "H_tot": H_tot, "H_stem": H_stem, "D_emb": D_emb, "Ka": Ka, "Kp": Kp,
        "Kae": Kae, "dKae": dKae, "seismic_valid": seismic_valid, "kh": kh,
        "df_v": df_v, "V_all": V_all, "MR_all": MR_all, "V_noq": V_noq, "MR_noq": MR_noq,
        "Pa": Pa, "Pq": Pq, "Pw": Pw, "dPae": dPae, "Pir": Pir, "yir": yir,
        "Pp_front": Pp_front, "Pp_key": Pp_key, "mu_eff": mu_eff, "c_d": c_d,
        "case_stat": case_stat, "case_seis": case_seis,
        "press_stat": q_stat, "press_seis": q_seis,
        "SF_gov_stat": SF_gov_stat, "SF_gov_seis": SF_gov_seis,
        "rebar_stem": rebar_stem, "rebar_heel": rebar_heel, "rebar_toe": rebar_toe,
        "rebar_pocket": rebar_pocket, "found_rows": pd.DataFrame(rows_found),
        "warnings": warnings,
    }


