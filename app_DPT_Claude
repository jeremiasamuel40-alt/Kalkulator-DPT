def create_cross_section_plot(p, res):
    fig, ax = plt.subplots(figsize=(8.5, 6.2), dpi=160)
    B, H_tot = res["B"], res["H_tot"]
    pr = res["press_stat"]

    poly_pts = [
        (0.0, 0.0), (B, 0.0), (B, p.t_slab_tip),
        (p.B_toe + p.t_bot, p.t_slab_base), (p.B_toe + p.t_bot, H_tot),
        (p.B_toe + (p.t_bot - p.t_top), H_tot), (p.B_toe, p.t_slab_base),
        (0.0, p.t_slab_base),
    ]
    ax.add_patch(patches.Polygon(poly_pts, closed=True, facecolor="#D3D7DC",
                                 edgecolor="#1F2937", linewidth=1.8, label="Beton DPT"))
    if p.use_shear_key and p.D_key > 0:
        ax.add_patch(patches.Rectangle((p.B_toe + p.t_bot - p.B_key, -p.D_key), p.B_key, p.D_key,
                                       facecolor="#B0B7C0", edgecolor="#1F2937", linewidth=1.5))
    if p.use_fence and p.H_panel > 0:
        fx0 = p.B_toe + (p.t_bot - p.t_top) + (p.t_top - 0.17) / 2.0
        ax.add_patch(patches.Rectangle((fx0, H_tot), 0.17, p.H_panel, facecolor="#E5E7EB",
                                       edgecolor="#374151", linewidth=1.3, hatch="//"))
        if p.H_wire > 0:
            ax.plot([fx0 + 0.085] * 2, [H_tot + p.H_panel, H_tot + p.H_panel + p.H_wire],
                    color="#4B5563", lw=1.5, ls="--")

    ax.plot([p.B_toe + p.t_bot, B + 1.2], [H_tot, H_tot], color="#78350F", lw=2.2)
    ax.fill_between([p.B_toe + p.t_bot, B + 1.2], p.t_slab_base, H_tot, color="#FDE68A",
                    alpha=0.35, label="Tanah Urug (Backfill)")
    front_y = p.t_slab_base + p.D_f
    ax.plot([-1.0, p.B_toe], [front_y, front_y], color="#065F46", lw=2.2)
    ax.fill_between([-1.0, p.B_toe], 0.0, front_y, color="#A7F3D0", alpha=0.35, label="Tanah Depan (Df)")

    scale_p = 0.8 / max(10.0, res["Ka"] * p.gamma_1 * H_tot)
    p_base = res["Ka"] * p.gamma_1 * H_tot * scale_p
    x_diag = B + 0.25
    ax.plot([x_diag, x_diag, x_diag + p_base, x_diag], [0, H_tot, 0, 0], color="#DC2626", lw=1.5)
    ax.fill([x_diag, x_diag + p_base, x_diag], [H_tot, 0, 0], color="#FCA5A5", alpha=0.45)
    ax.text(x_diag + p_base * 0.35, H_tot / 3.0 + 0.12, f"Pa = {res['Pa']:.1f} kN/m",
            color="#991B1B", fontsize=8.5, fontweight="bold")

    y0_q = -p.D_key - 0.15
    q_max_plot = max(pr["q_max"], 1.0)
    scale_q = 0.65 / max(50.0, q_max_plot)
    xs = np.linspace(0.0, B, 80)
    qs = np.asarray(pr["fn"](xs), dtype=float)
    ys = y0_q - qs * scale_q
    ax.fill(np.concatenate([xs, xs[::-1]]), np.concatenate([ys, np.full_like(xs, y0_q)]),
            color="#93C5FD", alpha=0.45)
    ax.plot(xs, ys, color="#2563EB", lw=1.5)
    ax.plot([0, B], [y0_q, y0_q], color="#2563EB", lw=1.0)
    ax.text(0.02, y0_q - q_max_plot * scale_q - 0.18, f"q_toe = {pr['q_toe']:.1f} kPa",
            color="#1E40AF", fontsize=8.5, fontweight="bold")
    ax.text(max(0.0, B - 0.9), y0_q - q_max_plot * scale_q - 0.18, f"q_heel = {pr['q_heel']:.1f} kPa",
            color="#1E40AF", fontsize=8.5)
    ax.text(B / 2.0, y0_q - q_max_plot * scale_q - 0.45,
            f"B = {B:.2f} m (Toe={p.B_toe:.2f}, Heel={p.B_heel:.2f}) | {pr['mode']}",
            ha="center", fontsize=9, fontweight="bold", color="#111827")

    ax.set_xlim(-1.1, B + 1.5)
    ax.set_ylim(y0_q - q_max_plot * scale_q - 0.7, H_tot + (p.H_panel + p.H_wire if p.use_fence else 0) + 0.45)
    ax.set_aspect("equal")
    ax.grid(True, linestyle=":", alpha=0.5)
    ax.set_title(f"Sketsa Penampang & Distribusi Gaya — {p.wall_type_name}", fontsize=11, fontweight="bold")
    ax.set_xlabel("Lebar (m)")
    ax.set_ylabel("Elevasi Relatif (m)")
    plt.tight_layout()
    return fig


